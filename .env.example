# =======================================================
# SwasthAI Outreach Infrastructure Environment Variables
# =======================================================

# 1. Brevo Transactional Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=swasthai.founder@gmail.com

# 2. Official Meta WhatsApp Business Platform / Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_account_id_here
WHATSAPP_API_VERSION=v20.0

# 3. Webhook Security Verification Token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=swasthai_secure_webhook_token_2026

# 4. Sandbox / Founder Test Number (Routes test sends directly to founder)
WHATSAPP_TEST_NUMBER=+919140721395

# 5. Daily Safety Quota (Asia/Kolkata timezone send limit)
WHATSAPP_DAILY_LIMIT=10
